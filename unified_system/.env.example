# Copy to .env locally; never commit real credentials.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./unified_system/data/unified-dev.db
DATA_DIR=./data
COOKIE_SECURE=0
# Production: inject a Fernet key from a secret manager; do not store beside the database.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Set distinct high-entropy values for private worker-to-backend channels only.
WORKER_TOKEN_CHAOXING=
WORKER_TOKEN_ZHIHUISU=
WORKER_TOKEN_YINGHUA=
WORKER_LEASE_TTL_SECONDS=60
WORKER_HEARTBEAT_TTL_SECONDS=90
