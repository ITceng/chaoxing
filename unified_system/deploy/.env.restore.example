# Disposable restore-rehearsal environment only. Copy to .env.restore, use unique values,
# chmod 600, and never point this Compose project at a production PGDATA volume.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_ADMIN_USER=unified_restore_cluster_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DB_NAME=unified_learning_restore_seed
APP_DB_OWNER=unified_restore_migrator
APP_DB_OWNER_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DB_USER=unified_restore_runtime
APP_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_TEST_ONLY_FERNET_KEY
CREDENTIAL_ENCRYPTION_KEYS_JSON=
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=
EDGE_PORT=18080
TEST_POSTGRES_PORT=55432
VITE_API_BASE_URL=/api/v1
TRUSTED_PROXY_HOPS=1
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
WORKER_LEASE_TTL_SECONDS=60
WORKER_HEARTBEAT_TTL_SECONDS=90
WORKER_TOKEN_CHAOXING=
WORKER_TOKEN_ZHIHUISHU=
WORKER_TOKEN_YINGHUA=
WORKER_ID_CHAOXING=chaoxing-restore-test
WORKER_ID_ZHIHUISHU=zhihuishu-restore-test
WORKER_ID_YINGHUA=yinghua-restore-test
WORKER_ADAPTER_FACTORY_CHAOXING=
WORKER_ADAPTER_FACTORY_ZHIHUISHU=
WORKER_ADAPTER_FACTORY_YINGHUA=
AI_HTTPS_PROXY=
WORKER_CHAOXING_HTTPS_PROXY=
WORKER_ZHIHUISHU_HTTPS_PROXY=
WORKER_YINGHUA_HTTPS_PROXY=
BACKUP_AGE_RECIPIENT=REPLACE_WITH_AGE_PUBLIC_RECIPIENT
