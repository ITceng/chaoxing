# Host-side Nginx renderer settings. Copy to .env.nginx only after an authorized domain is chosen.
# These are placeholders, not a registered domain or issued certificate.
PUBLIC_DOMAIN=REPLACE_WITH_REGISTERED_LOWERCASE_FQDN
TLS_FULLCHAIN_PATH=/etc/letsencrypt/live/REPLACE_WITH_REGISTERED_LOWERCASE_FQDN/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/REPLACE_WITH_REGISTERED_LOWERCASE_FQDN/privkey.pem
