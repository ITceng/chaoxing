# Render with deploy/nginx/render-nginx-config.py https after PUBLIC_DOMAIN and a valid
# certificate/key are installed. The renderer substitutes only the named ${...} placeholders.
# This is a dedicated-host default-server template; review existing Nginx vhosts before install.

limit_req_zone $binary_remote_addr zone=unified_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=unified_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=unified_register:10m rate=3r/m;
limit_req_zone $binary_remote_addr zone=unified_reset:10m rate=3r/m;
limit_conn_zone $binary_remote_addr zone=unified_connections:10m;
limit_req_status 429;
limit_conn_status 429;
server_tokens off;

log_format unified_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                        '$status $body_bytes_sent $request_time';

server {
    listen 80 default_server;
    server_name ${PUBLIC_DOMAIN};
    access_log /var/log/nginx/unified-learning.access.log unified_safe;
    error_log /var/log/nginx/unified-learning.error.log warn;

    if ($host != ${PUBLIC_DOMAIN}) { return 444; }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://${PUBLIC_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    server_name ${PUBLIC_DOMAIN};
    access_log /var/log/nginx/unified-learning.access.log unified_safe;
    error_log /var/log/nginx/unified-learning.error.log warn;

    if ($host != ${PUBLIC_DOMAIN}) { return 444; }

    ssl_certificate ${TLS_FULLCHAIN_PATH};
    ssl_certificate_key ${TLS_PRIVATE_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:unified_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 1m;
    client_header_timeout 15s;
    client_body_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 30s;

    # The renderer withholds this header by default. Add it only after public HTTPS is verified.
    ${HSTS_HEADER}
    include /etc/nginx/snippets/unified-learning-security-headers.conf;

    # The public host proxy is the only trusted client-IP boundary. Replace inbound
    # forwarding headers rather than appending attacker-supplied values.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 3s;
    proxy_send_timeout 65s;
    proxy_read_timeout 70s;
    proxy_redirect off;
    proxy_intercept_errors off;
    proxy_next_upstream off;

    # The public Nginx layer owns response security headers. Do not duplicate or
    # trust headers supplied by an upstream application/container.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Content-Security-Policy;

    # Health/readiness is available only to local monitoring. Keep the backend's
    # detailed readiness path inaccessible from the public Internet.
    location = /health/ {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        limit_except GET HEAD { deny all; }
        proxy_pass http://127.0.0.1:8080/api/v1/health/ready;
    }

    location = /api/v1/health/ready {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        limit_except GET HEAD { deny all; }
        proxy_pass http://127.0.0.1:8080/api/v1/health/ready;
    }

    # The edge-container liveness probe is not a public endpoint.
    location = /healthz { return 404; }

    # Worker internal APIs must never be reachable through either Nginx layer.
    location = /api/internal/workers { return 404; }
    location ^~ /api/internal/workers/ { return 404; }

    location = /api/v1/auth/login {
        limit_req zone=unified_login burst=5 nodelay;
        limit_conn unified_connections 20;
        proxy_pass http://127.0.0.1:8080;
    }

    location = /api/v1/auth/register {
        limit_req zone=unified_register burst=2 nodelay;
        limit_conn unified_connections 10;
        proxy_pass http://127.0.0.1:8080;
    }

    location = /api/v1/auth/reset-password {
        limit_req zone=unified_reset burst=2 nodelay;
        limit_conn unified_connections 10;
        proxy_pass http://127.0.0.1:8080;
    }

    location ^~ /api/ {
        limit_req zone=unified_api burst=40 nodelay;
        limit_conn unified_connections 20;
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
        limit_conn unified_connections 20;
        proxy_pass http://127.0.0.1:8080;
    }
}
