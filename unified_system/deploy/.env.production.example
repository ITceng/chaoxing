# Copy to .env.production, set it to mode 0600, and replace every placeholder.
# Never commit .env.production. Compose variables are read by docker compose only.

# Tags are usable defaults. Before production, pin these to reviewed registry digests.
POSTGRES_IMAGE=postgres:16-alpine
PYTHON_BASE=python:3.12-slim-bookworm
NODE_BASE=node:20-alpine
NGINX_BASE=nginx:alpine
POSTGRES_ADMIN_USER=unified_cluster_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DB_NAME=unified_learning
APP_DB_OWNER=unified_migrator
APP_DB_OWNER_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DB_USER=unified_app
APP_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

# Generate independent random values with a trusted secret manager.
# APP_SECRET_KEY must be >=32 characters; Fernet key must be valid base64 Fernet format.
APP_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_VALID_FERNET_KEY

EDGE_PORT=8080
TRUSTED_PROXY_HOPS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
WORKER_LEASE_TTL_SECONDS=60
WORKER_HEARTBEAT_TTL_SECONDS=90

# Worker tokens are intentionally blank until an adapter is verified and approved.
WORKER_TOKEN_CHAOXING=
WORKER_TOKEN_ZHIHUISU=
WORKER_TOKEN_YINGHUA=
WORKER_ID_CHAOXING=chaoxing-worker-01
WORKER_ID_ZHIHUISU=zhihuishu-worker-01
WORKER_ID_YINGHUA=yinghua-worker-01
WORKER_ADAPTER_FACTORY_CHAOXING=
WORKER_ADAPTER_FACTORY_ZHIHUISU=
WORKER_ADAPTER_FACTORY_YINGHUA=
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_REQUEST_TIMEOUT_SECONDS=10
WORKER_CANCEL_GRACE_SECONDS=5

# Public encryption recipient only; keep the private age identity offline or in a secret manager.
BACKUP_AGE_RECIPIENT=age1replace_this_with_an_actual_public_recipient
BACKUP_RETENTION_DAYS=30
