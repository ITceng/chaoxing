FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt requirements-panel.txt ./
RUN pip install --no-cache-dir -r requirements-panel.txt

COPY . /app

RUN useradd --create-home --uid 10001 appuser && \
    mkdir -p /data && \
    chown -R appuser:appuser /app /data

ENV PANEL_DATA_DIR=/data \
    PANEL_HOST=0.0.0.0 \
    PANEL_PORT=8080

VOLUME /data
EXPOSE 8080
USER appuser

# 必须单 worker：RunnerManager 的状态在进程内，多 worker 会重复启动账号任务
CMD ["gunicorn", "--workers", "1", "--threads", "8", "--timeout", "120", \
     "--access-logfile", "-", "--bind", "0.0.0.0:8080", "panel:app"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=3)" || exit 1
